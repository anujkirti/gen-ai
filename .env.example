# ---------------------------------------------------------------------------
# LabelCheck environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Vite reads `.env` once at startup - restart `npm run dev` after editing.
# ---------------------------------------------------------------------------

# --- Supabase (Project settings -> API) -------------------------------------
# Browser-visible copy (bundled into the client build, safe to expose).
VITE_SUPABASE_URL=https://gbxlfbqqasxzqsrqfkfp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cL5A76h0HEoTe3ONtnw-lw_u7ZtPRxy

# Server-side copy for SSR and server functions. Same values, no VITE_ prefix.
SUPABASE_URL=https://gbxlfbqqasxzqsrqfkfp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cL5A76h0HEoTe3ONtnw-lw_u7ZtPRxy

# --- OCR (server-only, never reaches the browser) ---------------------------
# Any OpenAI-compatible vision model. Key from https://platform.openai.com/api-keys
# For Google Gemini instead: key from https://aistudio.google.com/apikey, then
#   OCR_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   OCR_MODEL=gemini-2.5-flash
OCR_API_KEY=replace-with-your-openai-compatible-api-key
OCR_API_URL=https://api.openai.com/v1/chat/completions
OCR_MODEL=gpt-4.1-mini

# --- E-mail (server-only, optional) — Resend, key from https://resend.com/api-keys
# Powers the welcome mail and "E-mail report". Leave the key empty to disable.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=Feature Scan <labelcheck@anshguptaa.in>
PUBLIC_APP_URL=https://sih.anshguptaa.in

# --- Google sign-in (client id is public; the secret lives only in Supabase) -
# Enables the Google Identity Services flow so the consent screen shows
# "LabelCheck" instead of the Supabase project domain. Unset = redirect flow.
VITE_GOOGLE_CLIENT_ID=760261398933-2103hfm8gp1ep7n37fehcbb4pet4i0gu.apps.googleusercontent.com
